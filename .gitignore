# ---- DeepSeek Harness 本地数据 ----
# 会话、附件、凭据等本地运行状态，不应上传
.dsh/

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example
*.key

# ---- 向量库与本地数据库 ----
# 由 dsh-knowledge 构建的向量索引，可本地重建
chroma_db/
*.db

# ---- 常见附加忽略（按需保留） ----
# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
